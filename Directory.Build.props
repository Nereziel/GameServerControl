<Project>
  <!--
    Project-wide build properties for the Shared library and Agent/API/Web application.
    The Agent update checker reads InformationalVersion and compares it with the latest GitHub release.
  -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Company>TK-ECLIPSE</Company>
    <Authors>TK-ECLIPSE</Authors>
    <Product>GameServerControl</Product>
  </PropertyGroup>
</Project>
