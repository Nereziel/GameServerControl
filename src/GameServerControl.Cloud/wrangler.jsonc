{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameservercontrol-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [{
    "binding": "HOSTS_DB",
    "database_name": "gameservercontrol-hosts",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "secrets": {
    "required": [
      "GATEWAY_ORIGIN",
      "GATEWAY_SHARED_KEY",
      "HOSTS_ENCRYPTION_KEY",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_POLICY_AUD"
    ]
  }
}
