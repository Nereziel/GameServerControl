{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameservercontrol-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "AGENT_ORIGIN",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_POLICY_AUD",
      "AGENT_API_TOKEN",
      "ORIGIN_ACCESS_CLIENT_ID",
      "ORIGIN_ACCESS_CLIENT_SECRET"
    ]
  }
}
