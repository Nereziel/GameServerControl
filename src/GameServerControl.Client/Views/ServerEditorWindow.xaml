<Window x:Class="GameServerControl.Client.Views.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        Title="Server" Width="720" Height="760"
        Background="{StaticResource BgBrush0}" Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderText" Text="Add Server" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Common settings are shown first. Unsupported game features are hidden automatically."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Game preset" VerticalAlignment="Center"/>
                <ComboBox x:Name="PresetCombo" Grid.Column="1" ItemsSource="{Binding Presets}" DisplayMemberPath="Label"
                          SelectedValuePath="Key" SelectedValue="{Binding SelectedPresetKey}" Padding="7,5"/>
            </Grid>
            <TextBlock Text="{Binding ProfileNote}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="120,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ProfileNote, Converter={x:Static vm:NotNullVisibilityConverter.Instance}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="General" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Server ID"/><TextBlock Text="Internal identifier" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox x:Name="IdBox" Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Run server on"/><TextBlock Text="BareMetal = this machine" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableHostingModes}" SelectedItem="{Binding HostingMode}" Padding="7,5"/></Grid>

                <Border Padding="12" Margin="0,0,0,12" Background="{StaticResource BgBrush1}" CornerRadius="6" Visibility="{Binding ShowVmSettings, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="Hyper-V virtual machine" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="VM name"/><TextBox Grid.Column="1" Text="{Binding VmName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Guest credentials"/><TextBlock Text="Credential ID from Agent config" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><TextBox Grid.Column="1" Text="{Binding GuestCredentialId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Storage &amp; logs" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Server folder"/><TextBlock Text="Install / working directory" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding GuestWorkingDir, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Cascadia Mono"/></Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Save folders"/><TextBlock Text="Used for backups" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1"><TextBox Text="{Binding SaveDirsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Mono"/><TextBlock Text="{Binding StorageHint}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
                <Grid Margin="0,0,0,10" Visibility="{Binding ShowLogSettings, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Log file"/><TextBlock Text="Used by Live Log" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding LogPathInGuest, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Cascadia Mono"/></Grid>

                <Border Padding="12" Margin="0,8,0,12" Background="{StaticResource BgBrush1}" CornerRadius="6" Visibility="{Binding ShowRconSettings, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="Remote console (RCON)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Shown only when GameServerControl has an RCON handler for this game. 'auto' means localhost on this machine or the detected VM address."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Host"/><TextBox Grid.Column="1" Text="{Binding RconHost, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Port"/><TextBox Grid.Column="1" Text="{Binding RconPort, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Password"/><TextBox Grid.Column="1" Text="{Binding RconPassword, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                    </StackPanel>
                </Border>

                <Expander Header="Advanced settings" IsExpanded="{Binding ShowAdvanced}" Margin="0,8,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Normally filled by the game profile. Change these only for custom layouts, launchers, or troubleshooting."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Server EXE"/><TextBox Grid.Column="1" Text="{Binding GuestExePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Cascadia Mono"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Steam App ID"/><TextBox Grid.Column="1" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Game type"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableGameTypes}" SelectedItem="{Binding GameType}"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start args"/><TextBlock Text="One per line" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding StartArgsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Mono"/></Grid>
                        <StackPanel Visibility="{Binding ShowLifecycleSettings, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scheduled task"/><TextBlock Text="Optional advanced launcher" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding ScheduledTaskName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Extra stop processes"/><TextBlock Text="Normally leave empty" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding StopProcessNamesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas, Cascadia Mono"/></Grid>
                        </StackPanel>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Discord webhook"/><TextBlock Text="Optional notifications" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel><TextBox Grid.Column="1" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Cascadia Mono"/><Button Grid.Column="2" Content="Send test" Style="{StaticResource ActionButton}" Click="TestDiscord_Click" Margin="8,0,0,0"/></Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding ValidationError}" Foreground="{StaticResource BadBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ValidationError, Converter={x:Static vm:NotNullVisibilityConverter.Instance}}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Style="{StaticResource ActionButton}" Click="Cancel_Click"/><Button Content="Save" Style="{StaticResource ActionButton}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
