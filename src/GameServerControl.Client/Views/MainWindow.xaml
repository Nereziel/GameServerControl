<Window x:Class="GameServerControl.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        Title="Game Server Control" Width="1100" Height="720"
        Icon="pack://application:,,,/Assets/logo.ico"
        Background="{StaticResource BgBrush0}" Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext><vm:MainViewModel /></Window.DataContext>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel><TextBlock Text="Game Server Control" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding AgentUrl}" Foreground="{StaticResource TextDimBrush}" FontSize="11"/></StackPanel>
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource BadBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource GoodBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ConnectionLabel}" Margin="7,0,0,0"/></StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Create Server" Style="{StaticResource ActionButton}" Command="{Binding CreateServerCommand}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <Button Content="Discover" Style="{StaticResource ActionButton}" Command="{Binding DiscoverServersCommand}"/>
                    <Button Content="Refresh" Style="{StaticResource ActionButton}" Command="{Binding RefreshAllCommand}"/>
                    <Button Content="Add existing" Style="{StaticResource ActionButton}" Command="{Binding AddServerCommand}"/>
                    <Button Content="Tokens" Style="{StaticResource ActionButton}" Command="{Binding OpenTokensCommand}"/>
                    <Button Content="Settings" Style="{StaticResource ActionButton}" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="20,8" Visibility="{Binding UpdateAvailable, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="New release available."/><TextBlock Text="{Binding UpdateBannerText, StringFormat=' {0}'}" FontWeight="Bold"/><Button Content="Update / release" Style="{StaticResource ActionButton}" Command="{Binding OpenUpdateUrlCommand}" Margin="14,0,0,0"/></StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GameIcon}" FontSize="28" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding GameLabel, StringFormat=' · {0}'}" Foreground="{StaticResource TextDimBrush}" Margin="6,2,0,0"/>
                                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0" Visibility="{Binding HasMultipleAgents, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"><TextBlock Text="{Binding AgentNickname}" FontSize="11" Foreground="{StaticResource InfoBrush}"/></Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding HostingLabel}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding ProcBadgeColor}" VerticalAlignment="Center"/><TextBlock Text="{Binding ProcBadge}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel></Border>
                                            <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Visibility="{Binding HasCpuRam, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"><TextBlock Text="{Binding CpuRamText}" FontSize="11"/></Border>
                                            <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Visibility="{Binding HasInviteCode, Converter={x:Static vm:BoolVisibilityConverter.Instance}}" Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="INVITE " FontSize="11"/><TextBlock Text="{Binding InviteCode}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono"/><Button Content="Copy" Padding="6,0" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" FontSize="10" Click="CopyInvite_Click" Tag="{Binding InviteCode}"/></StackPanel></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding IsBusy, Converter={x:Static vm:NotBoolConverter.Instance}}" Click="ToggleClicked"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasScheduledTask, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"><TextBlock Text="Autostart" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,6,0"/><CheckBox IsChecked="{Binding IsAutostartEnabled, Mode=OneWay}" IsEnabled="{Binding IsAutostartLoading, Converter={x:Static vm:NotBoolConverter.Instance}}" Click="AutostartClicked"/></StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="40,14,0,0">
                                    <Button Content="Start" Style="{StaticResource ActionButton}" Command="{Binding StartCommand}"/>
                                    <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}"/>
                                    <Button Content="Restart" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}"/>
                                    <ProgressBar IsIndeterminate="True" Width="100" Height="6" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                </StackPanel>

                                <Expander Header="Manage" Margin="40,10,0,0" Foreground="{StaticResource TextDimBrush}">
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button Content="Configuration" Style="{StaticResource ActionButton}" Command="{Binding ConfigureCommand}" Visibility="{Binding SupportsManagedConfig, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="Mods" Style="{StaticResource ActionButton}" Command="{Binding ModsCommand}" Visibility="{Binding SupportsMods, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="Backup now" Style="{StaticResource ActionButton}" Command="{Binding BackupCommand}"/>
                                        <Button Content="Backups" Style="{StaticResource ActionButton}" Command="{Binding BackupsCommand}"/>
                                        <Button Content="Live console" Style="{StaticResource ActionButton}" Command="{Binding LogCommand}" Visibility="{Binding HasLogPath, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="RCON console" Style="{StaticResource ActionButton}" Command="{Binding ConsoleCommand}" Visibility="{Binding HasRcon, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="Players" Style="{StaticResource ActionButton}" Command="{Binding PlayersCommand}" Visibility="{Binding HasPlayers, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="Stats" Style="{StaticResource ActionButton}" Command="{Binding StatsCommand}"/>
                                        <Button Content="Update server" Style="{StaticResource ActionButton}" Command="{Binding UpdateCommand}"/>
                                        <Button Content="Schedule" Style="{StaticResource ActionButton}" Command="{Binding ScheduleCommand}"/>
                                        <Button Content="Apply config" Style="{StaticResource ActionButton}" Command="{Binding ApplyConfigCommand}" Visibility="{Binding SupportsManagedConfig, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                        <Button Content="Edit" Style="{StaticResource ActionButton}" Command="{Binding EditCommand}"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="20,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activity" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/><Button Grid.Column="1" Command="{Binding DonateCommand}" Background="Transparent" BorderThickness="0" Padding="6,2"><TextBlock FontSize="11"><Run Text="PayPal · " Foreground="{StaticResource TextDimBrush}"/><Run Text="TK-ECLIPSE" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></TextBlock></Button></Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Toasts}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
