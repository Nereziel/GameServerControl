{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GameServerControl": "Debug"
    }
  },
  "Agent": {
    "_BindHelp": "The Agent serves both the API and Web UI. Loopback is safest by default; use a Tailscale/private IP only when direct remote access is required.",
    "Bind": "http://127.0.0.1:5099",

    "_BindHttpsHelp": "Optional second HTTPS listener, e.g. https://100.x.y.z:5443. A self-signed certificate is generated when enabled. For Cloudflare/Tailscale deployments, terminating HTTPS outside the Agent is usually simpler.",
    "BindHttps": "",
    "CertPassword": "",
    "CertSanHosts": "",
    "CertSanIps": "",

    "_TokenHelp": "Leave ApiToken as the placeholder below. The Agent generates a strong random bootstrap Admin token on first boot and stores it in encrypted secret-state.json. Additional managed tokens are stored one-way hashed in tokens.json.",
    "ApiToken": "REPLACE_WITH_32_CHARS+",

    "Repo": "Nereziel/GameServerControl",
    "ServersJsonPath": "servers.json",

    "_PublicRelayHelp": "Optional Linux VPS relay. Url must point to GameServerControl.Relay over Tailscale. A configured ApiToken is migrated to encrypted secret state; public-relay.json also stores its reusable token encrypted.",
    "PublicRelay": {
      "Url": "",
      "ApiToken": "",
      "TargetAddress": "",
      "PublicAddress": "",
      "StatePath": "public-relay.json"
    },

    "_AuditHelp": "Mutation audit logs default to <agent>/Logs/audit/. Retention defaults to 90 days and can be set from 1 to 3650 days.",
    "AuditLogPath": "",
    "AuditRetentionDays": 90,

    "_CloudGatewayHelp": "Optional Cloudflare Worker gateway. List only the managed Agent token IDs dedicated to that gateway; only those tokens may attach the verified remote-user identity to audit entries.",
    "CloudGateway": {
      "TrustedTokenIds": "cloud-admin,cloud-readonly"
    },

    "_CurseForgeHelp": "Optional secondary mod catalog. Obtain a CurseForge third-party API key, then map each supported community to its CurseForge game ID. A configured ApiKey is migrated to encrypted local secret state and is never sent to the browser.",
    "CurseForge": {
      "ApiKey": "",
      "Games": {
        "valheim": ""
      }
    },

    "_GuestCredentialsHelp": "Used only when a server is explicitly configured to run inside a Hyper-V VM through PowerShell Direct. Configured Password values are migrated to encrypted local secret state. BareMetal servers ignore this section.",
    "GuestCredentials": {
      "default": {
        "Username": "Administrator",
        "Password": "CHANGE_ME"
      }
    }
  }
}
