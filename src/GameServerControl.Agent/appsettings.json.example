{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GameServerControl": "Debug"
    }
  },
  "Agent": {
    "_BindHelp": "Bind the agent to a private interface. Loopback is safest by default; use a Tailscale IP only when you need direct Tailnet access.",
    "Bind": "http://127.0.0.1:5099",

    "_BindHttpsHelp": "Optional second HTTPS listener, e.g. https://100.x.y.z:5443. A self-signed certificate is generated when enabled.",
    "BindHttps": "",
    "CertPassword": "",

    "_TokenHelp": "Leave ApiToken as the placeholder below. The agent generates a strong random token on first boot and persists it here.",
    "ApiToken": "REPLACE_WITH_32_CHARS+",

    "Repo": "Nereziel/GameServerControl",
    "ServersJsonPath": "servers.json",

    "_AuditHelp": "Override audit log directory. Empty defaults to <agent>/Logs/audit/.",
    "AuditLogPath": "",

    "_CurseForgeHelp": "Optional secondary mod catalog. Obtain a CurseForge third-party API key, then map each Thunderstore community you want to augment to its CurseForge game ID. Keys stay server-side and are never sent to the browser.",
    "CurseForge": {
      "ApiKey": "",
      "Games": {
        "valheim": ""
      }
    },

    "GuestCredentials": {
      "default": {
        "Username": "Administrator",
        "Password": "CHANGE_ME"
      }
    }
  }
}
