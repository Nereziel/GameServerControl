{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameservercontrol-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "GATEWAY_BASE_URL",
      "GATEWAY_SECRET",
      "WINDOWS_AGENT_TOKEN"
    ]
  }
}
