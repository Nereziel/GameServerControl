[Unit]
Description=GameServerControl Agent (game-server dashboard backend)
Documentation=https://github.com/Nereziel/GameServerControl
After=network-online.target
Wants=network-online.target

[Service]
# Run as an unprivileged user dedicated to game-server hosting.
# The installer creates this account and owns the managed game/backup roots below.
User=gsc
Group=gsc

WorkingDirectory=/opt/gameservercontrol/agent
ExecStart=/opt/gameservercontrol/agent/GameServerControl.Agent

# Keep the cross-platform backend's backup location deterministic on Linux.
Environment=Agent__BackupRoot=/var/lib/gameservercontrol/backups

Restart=on-failure
RestartSec=10s

# Hardening — restrict what the agent can do beyond what it needs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

# The Agent may mutate only its own state, managed game installs and backups.
ReadWritePaths=/opt/gameservercontrol/agent /srv/gameservers /var/lib/gameservercontrol/backups

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
